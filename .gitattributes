# Normalise all text to LF in the repo so shell scripts and configs stay
# valid on the Linux SRCF host regardless of the checkout platform.
* text=auto eol=lf

# Shell scripts MUST be LF (CRLF breaks the `#!/bin/bash` shebang on Linux).
*.sh text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.docx binary
